DATABASE_URL=postgresql://user:password@localhost:5432/domestic_energy
FLASK_DEBUG=0
FLASK_ENV=production
LOG_LEVEL=INFO
EUROSTAT_CACHE_TTL_SECONDS=21600
EUROSTAT_STALE_TTL_SECONDS=86400
EUROSTAT_CACHE_MAX_ITEMS=128
EUROSTAT_TIMEOUT_SECONDS=10
EUROSTAT_RETRY_TOTAL=3
EUROSTAT_RETRY_BACKOFF_FACTOR=0.4
